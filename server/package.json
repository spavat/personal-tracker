{
	"name": "personal-tracker-server",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/main.js",
		"dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,nest \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
		"test": "vitest run",
		"migrate": "node --env-file-if-exists=.env dist/migrate.js",
		"create-owner": "node --env-file-if-exists=.env dist/scripts/create-owner.js",
		"seed-epic-token": "node --env-file-if-exists=.env dist/scripts/seed-epic-token.js",
		"check-stored-data": "node --env-file-if-exists=.env dist/scripts/check-stored-data.js",
		"import-strava": "node --env-file-if-exists=.env dist/scripts/import-strava.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1169.0",
		"@aws-sdk/s3-request-presigner": "^3.1169.0",
		"@napi-rs/canvas": "^1.1.1",
		"@nestjs/common": "^12.5.0",
		"@nestjs/config": "^12.1.1",
		"@nestjs/core": "^12.5.0",
		"@nestjs/platform-node": "^12.5.0",
		"@nestjs/schedule": "^12.0.4",
		"@personal-tracker/shared": "*",
		"@turf/helpers": "^7.4.0",
		"@turf/simplify": "^7.4.0",
		"@we-gold/gpxjs": "^1.2.1",
		"better-auth": "^1.7.25",
		"drizzle-orm": "^1.0.0-rc.5-ab785fc",
		"fast-xml-parser": "^5.12.1",
		"mongodb": "^7.9.0",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"sharp": "^0.35.5",
		"xmldom-qsa": "^1.1.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@nestjs/testing": "^12.5.0",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"concurrently": "^10.0.7",
		"dotenv": "^18.0.10",
		"drizzle-kit": "^1.0.0-rc.5-ab785fc",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
