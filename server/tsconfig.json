{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"rootDir": "src",
		"outDir": "dist",
		"strict": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noEmitOnError": true,
		"types": ["node"]
	},
	"include": ["src"]
}
