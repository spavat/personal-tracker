# Copy to ~/apps/personal-tracker/.env on the VPS (chmod 600). Read by docker compose for interpolation.

# Image tag, rewritten by the CI deploy job (commit sha); "latest" until the first deploy
TAG=latest

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Hosted S3 bucket (must allow CORS GET from https://tracker.spvt.fr: the browser reads presigned URLs)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Podcast sync (optional): gopodder base URL, e.g. http://gopodder:8080 when it shares the Traefik network
# (alias "gopodder"), else https://podcasts.spvt.fr; and a sync login created for Personal Tracker in its web UI
GOPODDER_URL=
GOPODDER_USERNAME=
GOPODDER_PASSWORD=

# Same values as the other apps in ~/apps/*/docker-compose.yml
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=
