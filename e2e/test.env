# e2e docker stack settings, read by docker compose (COMPOSE_ENV_FILES in the test scripts) and by db-config.js.
# Ports differ from the dev ones so the tests can run while the dev databases are up; a shell variable overrides them.
COMPOSE_PROJECT_NAME=personal-tracker-e2e
POSTGRES_PORT=5433
MONGO_PORT=27018
GARAGE_PORT=3901
